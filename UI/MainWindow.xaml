<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NvTeleGuard" Width="980" Height="780" MinWidth="800" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E"
        FontFamily="Segoe UI" FontSize="13" Foreground="#F0F0F0" SnapsToDevicePixels="True" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="HeaderBrush" Color="#252526"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#2D2D30"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#3E3E42"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#4CAF50"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#388E3C"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F3A21"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="DimBrush" Color="#7A7A7A"/>
    <SolidColorBrush x:Key="GreyPillBrush" Color="#6E6E6E"/>
    <SolidColorBrush x:Key="AmberBrush" Color="#FFB300"/>
    <SolidColorBrush x:Key="AmberSoftBrush" Color="#3D3212"/>
    <SolidColorBrush x:Key="RedBrush" Color="#E53935"/>
    <SolidColorBrush x:Key="LogBgBrush" Color="#151515"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="#3E3E42"/>
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#4E4E54"/>
    <!-- Colours the corner square where a ScrollViewer's two scrollbars meet -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#151515"/>

    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Margin" Value="0,14,0,2"/>
    </Style>

    <Style x:Key="SectionSub" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SecondaryHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
              </Trigger>
              <!-- Tag="busy": the code paints a progress fill into Background; keep it visible even while hovered -->
              <Trigger Property="Tag" Value="busy">
                <Setter TargetName="Bd" Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Cursor" Value="Wait"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="Margin" Value="8,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
              <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Txt" Property="TextDecorations" Value="Underline"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Pill" TargetType="Border">
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="9,2"/>
      <Setter Property="Margin" Value="10,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="{StaticResource GreyPillBrush}"/>
    </Style>

    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal">
              <Grid Width="46" Height="24">
                <Border x:Name="Track" CornerRadius="12" Background="{StaticResource GreyPillBrush}"/>
                <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
              </Grid>
              <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="{StaticResource HeaderBrush}">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="{StaticResource SecondaryHoverBrush}" CornerRadius="4" Margin="2"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="Height" Value="10"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="{StaticResource HeaderBrush}">
                  <Track x:Name="PART_Track" IsDirectionReversed="False">
                    <Track.Thumb>
                      <Thumb>
                        <Thumb.Template>
                          <ControlTemplate TargetType="Thumb">
                            <Border Background="{StaticResource SecondaryHoverBrush}" CornerRadius="4" Margin="2"/>
                          </ControlTemplate>
                        </Thumb.Template>
                      </Thumb>
                    </Track.Thumb>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="LogItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="6,1"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <ContentPresenter Margin="{TemplateBinding Padding}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="5*"/>
      <RowDefinition Height="3*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="18,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Path Grid.Column="0" Data="M12,2 L20,5 L20,11 C20,16 16,20 12,22 C8,20 4,16 4,11 L4,5 Z" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="26" Height="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="NvTeleGuard" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
          <TextBlock Text="NVIDIA telemetry blocker - reversible, logged, local-only" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
        <Border Grid.Column="2" x:Name="AdminPill" Style="{StaticResource Pill}" Background="{StaticResource GreyPillBrush}" Margin="0,0,16,0">
          <TextBlock x:Name="AdminPillText" Text="checking..." FontSize="11" Foreground="White"/>
        </Border>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="VersionText" Text="v0.0.0" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <Button x:Name="BtnCheckUpdates" Content="Check for Updates" Style="{StaticResource SecondaryButton}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Update banner -->
    <Border Grid.Row="1" x:Name="UpdateBanner" Visibility="Collapsed" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,1" Padding="18,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" x:Name="UpdateBannerText" Text="" VerticalAlignment="Center" TextWrapping="Wrap"/>
        <Button Grid.Column="1" x:Name="BtnUpdateLink" Content="Open release page" Style="{StaticResource LinkButton}" Visibility="Collapsed"/>
        <Button Grid.Column="2" x:Name="BtnUpdateClose" Content="Dismiss" Style="{StaticResource LinkButton}"/>
      </Grid>
    </Border>

    <!-- Action bar -->
    <Border Grid.Row="2" Padding="18,10" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock x:Name="SummaryText" Text="Scanning..." FontSize="14" FontWeight="SemiBold"/>
          <TextBlock x:Name="SummarySub" Text="" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,12,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BtnTestStatus" Content="Test Telemetry Status" Style="{StaticResource OutlineButton}"/>
          <Button x:Name="BtnRefresh" Content="Refresh" Style="{StaticResource SecondaryButton}"/>
          <Button x:Name="BtnSelectRecommended" Content="Select Recommended" Style="{StaticResource SecondaryButton}"/>
          <Button x:Name="BtnApply" Content="Apply Changes" Style="{StaticResource PrimaryButton}" IsEnabled="False"/>
          <Button x:Name="BtnRestoreAll" Content="Restore All Original" Style="{StaticResource SecondaryButton}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Targets -->
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="18,4,18,8">
      <StackPanel x:Name="SectionsPanel"/>
    </ScrollViewer>

    <!-- Activity log -->
    <Border Grid.Row="4" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="18,8,18,8" MinHeight="170">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Activity Log" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="BtnUndo" Content="Undo Last Action" Style="{StaticResource SecondaryButton}" IsEnabled="False"/>
            <Button x:Name="BtnOpenLog" Content="Open Log File" Style="{StaticResource LinkButton}"/>
            <Button x:Name="BtnClearLog" Content="Clear View" Style="{StaticResource LinkButton}"/>
          </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="{StaticResource LogBgBrush}" CornerRadius="6" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
          <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource MutedBrush}" ItemContainerStyle="{StaticResource LogItem}" ScrollViewer.HorizontalScrollBarVisibility="Auto" Padding="4"/>
        </Border>
      </Grid>
    </Border>

    <!-- Status bar -->
    <Border Grid.Row="5" Background="{StaticResource HeaderBrush}" Padding="18,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" x:Name="StatusText" Text="Ready" FontSize="11" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <CheckBox Grid.Column="1" x:Name="DryRunSwitch" Style="{StaticResource Switch}" Content="Dry run (log only, change nothing)" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
      </Grid>
    </Border>
  </Grid>
</Window>
